# Copy to .env for local development. Real values come from Secret Manager in deployment.

BTM_SESSION_SECRET=change-me
# MUST be a non-superuser, non-table-owning role (see db/migrations/0003_app_role.sql) —
# a superuser connection silently bypasses every Row-Level Security policy.
# In docker-compose.yml, "localhost" becomes "postgres" (the service name) —
# the password after btm_app: MUST match BTM_APP_DB_PASSWORD below, since
# that's the password docker-entrypoint.sh actually creates the role with.
BTM_DATABASE_URL=postgresql://btm_app:change-me@localhost:5432/btm
# Only read by backend/docker-entrypoint.sh, to create the btm_app role —
# never used to connect as anything. Keep in sync with BTM_DATABASE_URL above.
BTM_APP_DB_PASSWORD=change-me

# Model routing (models.yaml, tools/model_router.py) — NVIDIA NIM is the
# primary provider for every agent role except the browser-use scrapers
# (local Ollama, no key needed). Groq is orchestrator's rate-limit fallback
# (NVIDIA NIM free tier: 40 req/min).
NVIDIA_API_KEY=change-me
GROQ_API_KEY=change-me

# Copy to .env for local development. Real values come from Secret Manager in deployment.

BTM_SESSION_SECRET=change-me
# MUST be a non-superuser, non-table-owning role (see db/migrations/0003_app_role.sql) —
# a superuser connection silently bypasses every Row-Level Security policy.
# In docker-compose.yml, "localhost" becomes "postgres" (the service name) —
# the password after btm_app: MUST match BTM_APP_DB_PASSWORD below, since
# that's the password docker-entrypoint.sh actually creates the role with.
BTM_DATABASE_URL=postgresql://btm_app:change-me@localhost:5432/btm
# Only read by backend/docker-entrypoint.sh, to create the btm_app role —
# never used to connect as anything. Keep in sync with BTM_DATABASE_URL above.
BTM_APP_DB_PASSWORD=change-me

# Model routing (models.yaml, tools/model_router.py) — NVIDIA NIM is primary
# for every agent role. Groq is the non-local fallback for research calls.
# NVIDIA_API_KEY also drives conversation-turn embeddings (tools/embeddings.py);
# if unset, embed() returns None and memory falls back to recency-only.
NVIDIA_API_KEY=change-me
GROQ_API_KEY=change-me

# Local dev only — skips session-cookie auth AND the entire waitlist/OAuth
# onboarding gate, auto-attaching a fixed dev-tenant/dev-user admin session
# to every request instead (api/middleware/auth.py). Requires the exact
# string "true"; anything else (including unset) is normal auth. NEVER set
# this anywhere real deployment config is defined (agent.yaml does not and
# must not reference it) — production reads secrets from Secret Manager,
# never from a .env file, so leaving this line commented out/absent is what
# keeps it out of production, not any runtime check.
# DEV_BYPASS=true
